# Copy this file to `.env` and fill in real values. Never commit `.env`.

# =============================================================================
# PriceIntel platform database (matches, history, tenants, API keys)
# Same Mongo cluster as Sadiq is fine — use a *different database name*.
# =============================================================================
PRICEINTEL_MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/?replicaSet=rs0&directConnection=true&authSource=admin
PRICEINTEL_DB_NAME=price_intel

# =============================================================================
# Default tenant catalog (Sadiq.ai). Use Sadiq-DB for development.
# Switch CATALOG_DB_NAME=Sadiq-DB-prod only when you are ready for production.
# Prefer a read-only Mongo user for the catalog URI.
# =============================================================================
CATALOG_MONGO_URI=mongodb://readonly_user:PASSWORD@HOST:27017/?replicaSet=rs0&directConnection=true&authSource=admin
CATALOG_DB_NAME=Sadiq-DB
CATALOG_PRODUCTS_COLLECTION=products
CATALOG_CATEGORIES_COLLECTION=categories
CATALOG_MARKETPLACES_COLLECTION=marketplaces
CATALOG_PRODUCT_GROUPS_COLLECTION=product_groups

# SADIQ_* names still work as aliases of CATALOG_* if you prefer them.
# SADIQ_MONGO_URI=...
# SADIQ_DB_NAME=Sadiq-DB
# SADIQ_PRODUCTS_COLLECTION=products
# SADIQ_CATEGORIES_COLLECTION=categories

TENANT_SLUG=sadiq
TENANT_NAME=Sadiq.ai
TENANT_API_KEY=pi_live_sadiq_replace_me
STOREFRONT_BASE_URL=https://www.sadiq.ai
STOREFRONT_PRODUCT_URL_TEMPLATE=https://www.sadiq.ai/product/{id}

# Platform admin key — used only to onboard new marketplace customers.
# Never give this key to a customer. They get TENANT_API_KEY (or a key
# generated by POST /v1/admin/tenants).
ADMIN_API_KEY=pi_admin_replace_me

# =============================================================================
# Redis (local docker compose, or Upstash later)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Matching (defaults; each tenant can override on their tenant record)
# =============================================================================
MATCH_MIN_SCORE=60
MATCH_AUTO_APPROVE_SCORE=92

# =============================================================================
# Email alerts — Gmail (dev@sadiq.ai)
# Create a Google App Password: Google Account → Security → 2-Step Verification
# → App passwords. Do NOT put the normal Gmail login password here.
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dev@sadiq.ai
SMTP_PASSWORD=crvn npff aqej xdrm
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=dev@sadiq.ai
ALERT_EMAIL_TO=dev@sadiq.ai
SLACK_WEBHOOK_URL=
ALERT_PRICE_GAP_PCT=5.0

# =============================================================================
# Scraping
# =============================================================================
SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_USER_AGENT=PriceIntelBot/1.0 (+mailto:info@sadiq.ai)
ENABLED_COMPETITORS=daraz

CATALOG_SYNC_ACTIVE_ONLY=false
COMPARE_ACTIVE_ONLY=true
COMPARE_IN_STOCK_ONLY=false
API_CORS_ORIGINS=*
